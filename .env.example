# HTTP service
PORT=4317
REIN_PUBLIC_URL=http://127.0.0.1:4317
REIN_DB=rein.db
REIN_MANDATE=mandate.json

# Use a long random value whenever hooks or live sandbox refunds are enabled.
REIN_TOKEN=
# Set to the number of trusted reverse-proxy hops (for example, 1 on Render).
REIN_TRUST_PROXY=
# Set to 1 outside the public transparency demo.
REIN_LOCK_OPERATOR_ENDPOINTS=

# PayPal sandbox only. Leaving these empty keeps the service in simulated mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# Beat the Gate challenge agents (Anthropic Claude or Groq OpenAI-compatible)
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
REIN_CHALLENGE_DAILY_TOKENS=100000
REIN_DISABLE_CHALLENGE=

# Checkpoint signing (Ed25519)
REIN_CHECKPOINT_KEY=
REIN_CHECKPOINT_KEY_FILE=

# Optional advisory summaries and policy-draft compilation.
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional MCP and ledger controls.
REIN_EXPOSE_AMOUNT_TOOL=
REIN_LEDGER_KEY=

# Optional remote approval notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_BOT_TOKEN=
SLACK_APPROVAL_CHANNEL=

# Optional TOTP secret for high-value action authentication
TOTP_SECRET=
